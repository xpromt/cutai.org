# Local development — copy to .env
# Matches docker-compose.yml at the repo root and the defaults in src/config.ts.
# For production ports/values, see scripts/docker-compose.prod.yml (5436/6383, PORT=3002, WEB_ORIGIN=https://cutai.org).
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/cutai
REDIS_URL=redis://localhost:6382
PORT=3001
WEB_ORIGIN=http://localhost:5173
SCORE_RATE_LIMIT_PER_HOUR=30
SCAN_RATE_LIMIT_PER_HOUR=10
FETCH_TIMEOUT_MS=5000
FETCH_MAX_BYTES=5242880
